# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── FRED API (optional but strongly recommended) ───────────────────────────────
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, fred_provider.py falls back to anonymous pandas_datareader
# (slower, occasionally rate-limited, 1-2 days stale).
FRED_API_KEY=your_fred_api_key_here

# ── Optional (defaults shown) ─────────────────────────────────────────────────
RISK_FREE_RATE=0.05

# ── Rate limits (slowapi format: "N/period") ───────────────────────────────────
# AI endpoints  — /chat, /unified/chat, /screen/chat  (Anthropic calls, cost money)
AI_RATE_LIMIT=30/hour
# Forecast      — /forecast (heavy CPU, 2 calls per full run)
FORECAST_RATE_LIMIT=20/hour
# Compute only  — /backtest, /screen/run, /screen/backtest, /regime/current
COMPUTE_RATE_LIMIT=60/hour
# Global cap across all endpoints per IP
GLOBAL_RATE_LIMIT=300/hour

# SQLite price store path (use Railway volume mount path in production)
# Railway: set to /data/prices.db and add a volume mounted at /data
PRICE_DB_PATH=./data/prices.db

# CORS — comma-separated list of allowed frontend origins
# Production: set to your Vercel domain
CORS_ORIGINS=https://qwant.vercel.app
