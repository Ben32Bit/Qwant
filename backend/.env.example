# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional (defaults shown) ─────────────────────────────────────────────────
RISK_FREE_RATE=0.05

# Rate limits (slowapi format: "N/period")
CHAT_RATE_LIMIT=20/hour
BACKTEST_RATE_LIMIT=60/hour

# SQLite price store path (use Railway volume mount path in production)
# Railway: set to /data/prices.db and add a volume mounted at /data
PRICE_DB_PATH=./data/prices.db

# CORS — comma-separated list of allowed frontend origins
# Production: set to your Vercel domain
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
